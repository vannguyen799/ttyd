{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": false,
    "esModuleInterop": true,
    "jsx": "react",
    "jsxFactory": "h",
    "allowJs": true,
    "noImplicitAny": false,
    "declaration": false,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "types": ["node"],
    "lib": ["es2023", "dom"],
  },
  "include": [
    "src/**/*.tsx",
    "src/**/*.ts"
  ]
}
