# Environment for the ttyd systemd unit — installed as /etc/default/ttyd.
#
# systemd reads this as KEY=VALUE lines: no shell, no expansion, no quotes
# needed around values with spaces. Every key is optional; start-ttyd.sh
# supplies the same defaults it uses interactively.
#
# Changing anything here needs only `systemctl restart ttyd`.

# Public port. 10090 is the port this deployment has always been reached on,
# not ttyd's own 7681.
TTYD_PORT=10090

# Bind address. 0.0.0.0 exposes the terminal on every interface; use
# 127.0.0.1 when a tunnel or reverse proxy (cloudflared, nginx) fronts it.
TTYD_BIND=127.0.0.1

# Basic-auth credentials. The service refuses to start a generated password —
# it would change on every restart and nobody would ever see it.
TTYD_USERNAME=user
TTYD_PASSWORD=change-me

# What a bare URL (no ?arg=...) opens. Same vocabulary as ttyd-session.sh:
# modifiers first, then an optional session spec. The UI sends its own args
# per tab, so this only decides the landing session.
#   TTYD_SESSION_ARGS=cwd:/home/dev/tools_repo/ttyd-pro name:main
#   TTYD_SESSION_ARGS=cwd:/srv/app codex:--dangerously-bypass-approvals-and-sandbox name:app
TTYD_SESSION_ARGS=name:main

# Where the UI keeps its tab layout, so every device pointed at this
# deployment sees the same tabs. Unset means ~/.local/state/ttyd/tabs.json;
# set it empty to go back to a per-browser layout in localStorage.
#   TTYD_TABS_FILE=/var/lib/ttyd/tabs.json

# Prebuilt binary to run. Unset means the fork's own build/ttyd, rebuilt
# automatically whenever a source file is newer.
#   TTYD_BIN=/usr/local/bin/ttyd
