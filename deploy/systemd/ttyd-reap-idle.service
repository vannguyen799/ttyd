# Snapshot and close idle tmux sessions — the unit the timer drives.
#
# A USER unit, not a system one: it must run as the person who owns the tmux
# server, and installing it needs no root. deploy/scripts/install-reaper.sh
# substitutes the @PLACEHOLDER@ values and writes the result to
# ~/.config/systemd/user/.
#
# Note this box has no `crontab` binary at all, so a systemd user timer is not
# a stylistic preference here — it is the only scheduler available. `Linger=yes`
# on the account is what lets it fire with nobody logged in.

[Unit]
Description=Snapshot and close idle ttyd/tmux sessions
Documentation=file://@FORK_ROOT@/deploy/scripts/ttyd-reap-idle.sh

[Service]
Type=oneshot
# Order matters: systemd applies Environment= and EnvironmentFile= in the order
# they appear and the later one wins. The install-time default goes FIRST so the
# env file can override it — otherwise editing ~/.config/ttyd-reap.env would
# have no effect, which is the opposite of why that file exists. The leading "-"
# keeps the unit valid when the file is absent.
Environment=TTYD_REAP_IDLE=@IDLE@
EnvironmentFile=-@ENV_FILE@
ExecStart=@FORK_ROOT@/deploy/scripts/ttyd-reap-idle.sh --quiet

# The reaper walks every session on the server and shells out to tmux; if it
# ever wedges, a hung oneshot would block the timer forever.
TimeoutStartSec=300
